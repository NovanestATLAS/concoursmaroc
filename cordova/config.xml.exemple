<?xml version='1.0' encoding='utf-8'?>
<!--
  Concours Maroc — exemple de config.xml pour Apache Cordova (Android)
  =====================================================================
  À fusionner avec le config.xml de votre projet (voir LISEZMOI-ANDROID.md).
  Les lignes marquées ★ sont nécessaires au nouveau dossier www.

  Vérifié le 10/10/2026 avec cordova-android 15.1.0 (API cible 36, exigée par
  Google Play pour les nouvelles applications et les mises à jour depuis le
  31 août 2026), admob-plus-cordova 2.0.0-alpha.19,
  cordova-plugin-consent 3.0.0-alpha.9 et cordova-plugin-tts-advanced 0.5.3 ;
  mis à jour le 19/10/2026 pour la bannière (plugin local
  cordova-plugin-system-insets) et Firebase (cordova-plugin-firebase-analytics
  9.0.0, -messaging 9.2.0, -config 9.0.0).

  - id : com.novanest.concoursmaroc, dans la lignée des autres applications
    Novanest ATLAS (com.novanest.…) ; c'est lui que donnent les liens Google
    Play du site novanestatlas.github.io. Si l'application est déjà publiée
    avec un autre identifiant, gardez le vôtre : il ne doit plus jamais
    changer une fois sur Google Play.
  - version : à augmenter à chaque envoi sur Google Play. Sans
    android-versionCode, Cordova le calcule (2.0.0 → 20000), ce qui reste
    supérieur à celui d'une version 1.x.
-->
<widget id="com.novanest.concoursmaroc" version="2.0.0"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:cdv="http://cordova.apache.org/ns/1.0">

    <name short="Concours Maroc">Concours Maroc</name>
    <description>Guide des concours au Maroc après le bac : conditions, seuils, calendrier, QCM corrigés, examens blancs et outils. En français et en arabe, utilisable hors ligne.</description>
    <author href="https://www.maroc-concour.com/">Novanest ATLAS</author>

    <content src="index.html" />

    <!-- ★ Liens externes (sources officielles, inscriptions, e-mail…) :
         ouverts dans le navigateur ou l'application du téléphone, jamais
         dans l'appli. Aucune page distante n'est chargée dans l'appli,
         d'où l'absence de <access> et de <allow-navigation>. -->
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="mailto:*" />
    <allow-intent href="tel:*" />
    <allow-intent href="sms:*" />
    <allow-intent href="geo:*" />
    <allow-intent href="market:*" />

    <platform name="android">
        <preference name="android-minSdkVersion" value="24" />
        <preference name="android-targetSdkVersion" value="36" />

        <!-- ★ L'appli est servie depuis https://localhost/ (valeurs par
             défaut de Cordova 10 et plus). Gardez les mêmes valeurs que la
             version précédente : la progression des élèves (questions vues,
             révisions, statistiques) est enregistrée pour cette adresse. -->
        <preference name="scheme" value="https" />
        <preference name="hostname" value="localhost" />

        <!-- ★ admob-plus-cordova et cordova-plugin-consent sont écrits en
             Kotlin : sans cette ligne, leur code n'est pas compilé. -->
        <preference name="GradlePluginKotlinEnabled" value="true" />

        <!-- ★ Barres système en dehors de la page (valeur par défaut) :
             l'en-tête et la barre d'onglets ne passent jamais dessous. La
             couleur de la barre d'état suit ensuite le thème choisi dans
             l'appli (clair ou sombre). -->
        <preference name="AndroidEdgeToEdge" value="false" />

        <!-- ★ Écran en portrait sur les téléphones : la bannière publicitaire
             est placée juste au-dessus de la barre de navigation, qui change
             de côté quand un téléphone tourne (la bannière se masque alors
             d'elle-même). Android 16 ignore ce réglage sur les tablettes et
             les écrans pliables ouverts, où la bannière reste en bas. -->
        <preference name="Orientation" value="portrait" />

        <!-- ★ Firebase (statistiques, alertes, annonces) : téléchargez
             google-services.json depuis la console Firebase (application
             Android com.novanest.concoursmaroc) et posez-le à la racine du
             projet Cordova, à côté de config.xml. Sans ce fichier, la
             compilation échoue dès qu'un plugin Firebase est installé. -->
        <resource-file src="google-services.json" target="app/google-services.json" />

        <!-- ★ Icône des notifications : silhouette blanche du logo (Android
             l'exige monochrome ; l'icône de l'appli donnerait un carré blanc).
             Dossier cordova/res/notification/ de ce dépôt, copié avec res/. -->
        <resource-file src="res/notification/android/drawable-mdpi/ic_stat_concours.png" target="app/src/main/res/drawable-mdpi/ic_stat_concours.png" />
        <resource-file src="res/notification/android/drawable-hdpi/ic_stat_concours.png" target="app/src/main/res/drawable-hdpi/ic_stat_concours.png" />
        <resource-file src="res/notification/android/drawable-xhdpi/ic_stat_concours.png" target="app/src/main/res/drawable-xhdpi/ic_stat_concours.png" />
        <resource-file src="res/notification/android/drawable-xxhdpi/ic_stat_concours.png" target="app/src/main/res/drawable-xxhdpi/ic_stat_concours.png" />
        <resource-file src="res/notification/android/drawable-xxxhdpi/ic_stat_concours.png" target="app/src/main/res/drawable-xxxhdpi/ic_stat_concours.png" />
        <config-file target="AndroidManifest.xml" parent="/manifest/application">
            <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_concours" />
        </config-file>

        <!-- ★ Lecture à voix haute (cordova-plugin-tts-advanced) : depuis
             Android 11, une appli ne voit les moteurs de synthèse vocale du
             téléphone que si elle le déclare, et ce plugin ne le fait pas. -->
        <config-file target="AndroidManifest.xml" parent="/manifest">
            <queries>
                <intent>
                    <action android:name="android.intent.action.TTS_SERVICE" />
                </intent>
            </queries>
        </config-file>

        <!-- ★ Icône et écran de démarrage. Copiez le dossier cordova/res/ de
             ce dépôt à la racine du projet Cordova (à côté de config.xml).
             Android 7 : icône classique (src) ; Android 8 et plus : icône
             adaptative (foreground + background), découpée par le téléphone
             en cercle, carré arrondi… ; Android 12 et plus : écran de
             démarrage, sur un fond de la couleur de l'icône. -->
        <icon density="ldpi"    src="res/icon/android/ldpi.png"    foreground="res/icon/android/ldpi-foreground.png"    background="res/icon/android/ldpi-background.png" />
        <icon density="mdpi"    src="res/icon/android/mdpi.png"    foreground="res/icon/android/mdpi-foreground.png"    background="res/icon/android/mdpi-background.png" />
        <icon density="hdpi"    src="res/icon/android/hdpi.png"    foreground="res/icon/android/hdpi-foreground.png"    background="res/icon/android/hdpi-background.png" />
        <icon density="xhdpi"   src="res/icon/android/xhdpi.png"   foreground="res/icon/android/xhdpi-foreground.png"   background="res/icon/android/xhdpi-background.png" />
        <icon density="xxhdpi"  src="res/icon/android/xxhdpi.png"  foreground="res/icon/android/xxhdpi-foreground.png"  background="res/icon/android/xxhdpi-background.png" />
        <icon density="xxxhdpi" src="res/icon/android/xxxhdpi.png" foreground="res/icon/android/xxxhdpi-foreground.png" background="res/icon/android/xxxhdpi-background.png" />
        <preference name="AndroidWindowSplashScreenAnimatedIcon" value="res/screen/android/splash-icon.png" />
        <preference name="AndroidWindowSplashScreenBackground" value="#F9F7F4" />
    </platform>

    <!-- Les plugins sont enregistrés dans package.json par « cordova plugin
         add » (commandes dans LISEZMOI-ANDROID.md). -->
</widget>
