{
  "name": "com.novanest.concoursmaroc",
  "displayName": "Concours Maroc",
  "version": "2.0.0",
  "description": "Concours Maroc : guide des concours au Maroc, QCM corrigés et examens blancs (application Android Cordova).",
  "private": true,
  "author": "Novanest ATLAS",
  "scripts": {
    "prepare-android": "cordova prepare android",
    "run-android": "cordova run android",
    "build-release": "cordova build android --release -- --packageType=bundle"
  },
  "devDependencies": {
    "admob-plus-cordova": "2.0.0-alpha.19",
    "cordova-android": "15.1.0",
    "cordova-launch-review": "4.2.0",
    "cordova-plugin-consent": "3.0.0-alpha.9",
    "cordova-plugin-firebase-analytics": "9.0.0",
    "cordova-plugin-firebase-config": "9.0.0",
    "cordova-plugin-firebase-messaging": "9.2.0",
    "cordova-plugin-play-update": "file:local-plugins/cordova-plugin-play-update",
    "cordova-plugin-system-insets": "file:local-plugins/cordova-plugin-system-insets",
    "cordova-plugin-tts-advanced": "0.5.3"
  },
  "cordova": {
    "platforms": [
      "android"
    ],
    "plugins": {
      "cordova-plugin-tts-advanced": {},
      "cordova-plugin-consent": {},
      "admob-plus-cordova": {
        "APP_ID_ANDROID": "ca-app-pub-XXXXXXXXXXXXXXXX~NNNNNNNNNN"
      },
      "cordova-launch-review": {},
      "cordova-plugin-play-update": {},
      "cordova-plugin-system-insets": {},
      "cordova-plugin-firebase-analytics": {
        "AUTOMATIC_SCREEN_REPORTING_ENABLED": "false"
      },
      "cordova-plugin-firebase-messaging": {},
      "cordova-plugin-firebase-config": {}
    }
  }
}
